{
  "expo": {
    "name": "local-marketplace",
    "slug": "localmarketplaceapp",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "b881819b-8ef1-4ffa-9dd7-9a67a2a10a0f"
      }
    },
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "localmarketplace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.taimoor.localmarketplace.dev",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/android-icon-monochrome.png",
          "color": "#007AFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Market to use your location to find nearby services and provide accurate listings.",
          "locationAlwaysPermission": "Allow Market to use your location for better service discovery even when app is in background."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "taimooriqbal308"
  }
}
