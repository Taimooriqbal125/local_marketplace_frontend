{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@theme/*": ["./src/theme/*"],
      "@services/*": ["./src/services/*"],
      "@store/*": ["./src/redux/*"],
      "@assets/*": ["./src/assets/*"],
      "@axios/*": ["./src/app/axios/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/**/*", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
